# Copy to .env and fill in. .env is gitignored & dockerignored — the token is a secret.
#
# Cloudflare is used ONLY as the model provider (Workers AI REST API). Nothing
# else about this app lives in Cloudflare — the server and the chat database run
# on your own machine.

# Cloudflare account ID: dash.cloudflare.com → any domain → right sidebar,
# or Workers & Pages → Overview → "Account ID".
CLOUDFLARE_ACCOUNT_ID=

# API token with the "Workers AI" → Read permission (that is the only scope it
# needs). Create at: dash.cloudflare.com → My Profile → API Tokens →
# Create Token → "Workers AI" template.
CLOUDFLARE_API_TOKEN=

# Optional overrides (sensible defaults are built in — see ai.js / server.js):
# KIDS_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# KIDS_NAMES=Ada,Grace,Sam
# PORT=3000
# DB_PATH=./data/chat.db
